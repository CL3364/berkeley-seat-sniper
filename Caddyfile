# Caddyfile — reverse proxy with automatic TLS for Berkeley Seat Sniper.
#
# Site address: set CADDY_SITE_ADDRESS in the environment (e.g. seatsniper.example.edu).
# Caddy provisions and renews TLS automatically when the address is a public hostname.
# For local testing use http://localhost or a bare IP — Caddy will serve plaintext.
#
# The app service (Hono) serves both /api/* routes and the SPA (dist/web) on port 8787.
# All traffic is proxied to it; no separate static-file handling needed at this layer.

{$CADDY_SITE_ADDRESS} {
    # Proxy all requests to the Hono application server.
    # `app` is the Docker Compose service name; resolves inside the shared network.
    reverse_proxy app:8787

    # Structured access logs; omit subscriber-identifying headers (no auth headers logged).
    log {
        output stdout
        format json
    }

    # Reasonable header hardening.
    header {
        # Prevent MIME sniffing.
        X-Content-Type-Options nosniff
        # Disallow framing except same-origin.
        X-Frame-Options SAMEORIGIN
        # Force HTTPS for one year (only meaningful when TLS is active).
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Remove the server banner.
        -Server
    }
}
