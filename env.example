# Berkeley Seat Sniper — environment template.
# Copy to `.env` (gitignored) and fill in. NEVER commit real secrets; the app
# reads these from the environment only (constitution). Values here are safe
# non-secret placeholders / documentation.

# --- Server ---
PORT=8787
NODE_ENV=development
# Loopback for local Compose. A real mail transport fails startup until this is
# changed to 0.0.0.0 (or the intended public interface), preventing dead links.
CADDY_BIND_ADDRESS=127.0.0.1
# Optional immutable deploy tag; the image name itself is Compose-project-scoped.
SEAT_SNIPER_IMAGE_TAG=local

# --- Database + Redis ---
# Production uses Compose-internal PostgreSQL/Redis addresses. Standalone
# development/tests may leave DATABASE_URL unset to use PGlite, but production
# and every real-mail process fail loudly without a shared PostgreSQL database.
# Required in production or with a real mail transport. Development/tests may
# leave it unset to use ephemeral in-process Postgres (PGlite).
DATABASE_URL=
# Required by the bundled Postgres service. Generate a strong local/deploy secret.
# Compose passes this raw value as PGPASSWORD; do not URL-encode it.
POSTGRES_PASSWORD=
# Bounded real-Postgres connect, statement/query, and lock waits.
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=20000
DB_LOCK_TIMEOUT_MS=5000
# Separate finite budget for startup schema upgrades; runtime queries stay tight.
DB_MIGRATION_TIMEOUT_MS=600000
# Required by production API instances for shared atomic abuse limits. Compose
# supplies its private service URL; standalone development can override it.
REDIS_URL=redis://localhost:6379/0
# Bound Redis so a key flood fails closed instead of exhausting the VPS.
REDIS_MAXMEMORY=128mb

# --- Token signing (FR-2: signed, expiring, per-subscriber manage links) ---
# Required in production. A long random string; rotate to invalidate all tokens.
TOKEN_SECRET=
TOKEN_TTL_SECONDS=2592000

# --- App base URL (FR-9, §4: emailed confirm/manage links) ---
# Public origin the dashboard is served from; confirm links are
# ${APP_BASE_URL}/?confirm=<token> and manage links ${APP_BASE_URL}/?token=<token>.
# REQUIRED by bundled Compose and also used as Caddy's site address, so the
# served origin cannot diverge from emailed credentials. Real mail requires
# HTTPS; local noop Compose may deliberately use http://localhost.
# Example: https://seatsniper.example.edu
APP_BASE_URL=

# --- Subscriber admission (FR-19) ---
# Fail closed by default. `closed` rejects only new subscriber creation; existing
# confirm, recovery, manage, watch-change, push, and unsubscribe flows stay available.
# Use `pilot` only after launch blockers pass. `public` remains implemented for
# local/CI tests or a future explicitly revisited decision; it is not a v1 launch mode.
ADMISSION_MODE=closed
# Required only when ADMISSION_MODE=pilot. Generate a high-entropy secret encoded
# as 32–256 characters of unpadded base64url (A–Z, a–z, 0–9, `_`, and `-`).
# Store it only in the deployment secret environment. Never commit or log it, put
# it in tickets/public chat, use URL shorteners/link tracking, or reuse it as an
# identity/authentication credential. Share only the private
# ${APP_BASE_URL}/?invite=<urlencoded-code> journey. Leave blank in closed/public;
# those modes do not consult this value.
PILOT_INVITE_CODE=

# --- Public-page source / scheduler (FR-3, FR-7, FR-16) ---
# The owner accepts proceeding without written or affirmative permission for
# recurring automated access. That risk acceptance is not evidence of Berkeley
# authorization, endorsement, or protection from blocking.
# This is a scheduler heartbeat, not a promise to bypass Berkeley cache metadata.
POLL_INTERVAL_SECONDS=30
POLL_JITTER_SECONDS=10
MAX_BACKOFF_SECONDS=600
MAX_CONSECUTIVE_CYCLE_FAILURES=8
# Owner-selected option A. One physical Berkeley-origin request/second is shared
# globally across all users, Sections, workers, robots/class requests, and
# redirects; it is not a per-user or per-Section rate. Cache-aware scheduling
# may use less. floor(0.8 × 1 × 120) caps Confirmed demand at 96 unique Sections
# while reserving overhead. These selected values do not enable live traffic:
# keep KILL_SWITCH=1 until the separate source/rollout gates pass.
SOURCE_VISIBLE_TARGET_SECONDS=120
SOURCE_REQUESTS_PER_SECOND=1
# Maximum age for worker liveness progress and for the last successful cycle
# advertised by push readiness (an intentional kill-switch tick counts as success).
WORKER_HEALTH_MAX_STALE_SECONDS=900
# Shared with the API when processes are separate; Compose overrides this into
# its named runtime volume.
WORKER_HEARTBEAT_FILE=/tmp/seat-sniper-worker-heartbeat
# Durable source-stop latch. A 429 stores its bounded effective cooldown /
# bounded Retry-After in origin state before this marker's fixed, non-PII
# resumeNotBefore; restart and reset cannot bypass it. This /tmp path is for
# local development; Compose uses runtime_data. Long-lived standalone deploys
# must use persistent storage.
SOURCE_SAFETY_STOP_FILE=/tmp/seat-sniper-source-safety-stop.json
# Durable source-origin coordination state. The worker automatically derives
# its sibling fence as `${SOURCE_ORIGIN_STATE_FILE}.fence`; Compose puts both in
# runtime_data. Backward-readable v2 preserves lastPermitAt and a bounded
# notBefore/notBeforeSetAt cooldown; permits honor the later of spacing and
# notBefore. Reset advances valid lastPermitAt to at least reset time without
# moving a future boundary backward and preserves any later cooldown. Missing/
# malformed/unreadable state is reinitialized to reset time only if atomic repair
# succeeds; otherwise reset fails and source stays stopped. This /tmp path is
# for local development only.
SOURCE_ORIGIN_STATE_FILE=/tmp/seat-sniper-origin-state.json
# REQUIRED for the worker: identify this deployment with a real monitored
# mailto: address or HTTPS operator page. Placeholder/example domains are rejected.
FETCH_USER_AGENT=
# Hard deadline for each upstream request, including response-body consumption.
FETCH_TIMEOUT_MS=10000
# Maximum bytes accepted from either a class page or robots.txt (hard-capped at 10 MiB).
FETCH_MAX_BODY_BYTES=1048576
# Robots rules normally live for one poll cycle (interval + jitter).
ROBOTS_CACHE_TTL_MS=40000
# Fail closed. Only the exact value `0` opts into source traffic; missing, empty,
# or invalid values remain disabled in the worker. The rate decision is closed,
# but keep this at 1 until current robots rules, the identifying contact,
# live-source canary, deployment config, source-safety-stop procedure, and all
# other rollout gates have been verified.
KILL_SWITCH=1
RESPECT_ROBOTS=1

# --- Durable mail queue + retention (FR-17, FR-18) ---
ALERT_EXPIRY_SECONDS=3600
PENDING_RETENTION_HOURS=72
TERMINAL_RETENTION_DAYS=90
RETENTION_SWEEP_INTERVAL_SECONDS=3600
OUTBOX_BATCH_SIZE=100
OUTBOX_CLAIM_LEASE_SECONDS=60

# --- Mail (FR-8: noop writes to an outbox log; real transports configured here) ---
# `noop` is for standalone development/test only and writes to an inspectable
# outbox. NODE_ENV=production rejects it; the production Compose topology pins
# this value to `real` and pins MAIL_PROVIDER to `resend`.
MAIL_TRANSPORT=noop
# Optional inspectable JSONL sink for the branded noop transport only. Under
# bundled Compose, use /app/runtime/outbox.ndjson (shared writable volume).
NOOP_OUTBOX_FILE=
# The only shipped real adapter in v0.3 is `resend` (the default).
MAIL_PROVIDER=resend
# Required for a real provider; use a sender on the verified sending domain.
MAIL_FROM=
# Operator inbox for parser-broke / scraper-failure alerts (NOT a subscriber address).
# REQUIRED (fail-loud at startup) for any non-noop transport and must be MONITORED, or a
# scraper break could go unnoticed and the pilot would silently stop alerting (FR-14).
# See ADR 0009 / docs/plans/0009.
OPERATOR_EMAIL=
# Real transport secrets (only when MAIL_TRANSPORT != noop) come from the env.
# Resend (MAIL_PROVIDER=resend): required RESEND_API_KEY.
RESEND_API_KEY=
# Resend bounce/complaint webhook secret (Svix). REQUIRED with MAIL_PROVIDER=resend or
# suppression silently never happens (FR-12). Webhook ingress is app-only, but both
# real-mail processes validate the shared configuration at startup. Its raw body
# is capped at exactly 32 KiB before signature verification or JSON parsing.
RESEND_WEBHOOK_SECRET=
# Hard deadline for each outbound email or push provider call.
SEND_TIMEOUT_MS=10000
# Stay below the default account-wide Resend request ceiling.
RESEND_REQUESTS_PER_SECOND=4

# --- Rate limiting (anti-abuse on subscribe + resend; implements the 429 code, FR-11) ---
# Per-IP window (default 5 / 60s) and per-email window (default 3 / 900s); exceeding
# EITHER returns 429 rate_limited. Applied to subscribe AND resend.
RATE_LIMIT_SUBSCRIBE_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EMAIL_MAX=3
RATE_LIMIT_EMAIL_WINDOW_SECONDS=900
# Set TRUST_PROXY=1 ONLY behind the authenticated bundled Caddy hop. Production
# requires it. The API ignores forwarded addresses unless the direct peer is
# private AND Caddy overwrote x-seat-sniper-proxy-secret with this shared value.
TRUST_PROXY=0
# Required whenever TRUST_PROXY=1; distinct from PILOT_INVITE_CODE. Generate
# 32–256 characters of unpadded base64url and inject the same value into Caddy
# and the API. Never log or reuse it for subscriber admission.
PROXY_HEADER_SECRET=
# Local diagnostics only. Never set this in production; it disables both IP and
# email rate limits and is honored only when exactly `1`.
DISABLE_RATE_LIMIT=0

# --- Web push (FR-15: additive, alerts-only; per-browser opt-in from the manage view) ---
# VAPID keys are SECRETS — generate your own and keep them in the environment only; the
# placeholders below are NOT valid keys. Absent keys disable push gracefully (the
# vapid-public-key route returns null and the UI hides the toggle).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Internal readiness thresholds ---
# /api/health is reachable only on the private Compose network. Caddy exposes
# the user-facing app but deliberately returns 404 for that internal probe.
HEALTH_SOURCE_MAX_STALE_SECONDS=240
HEALTH_OUTBOX_MAX_AGE_SECONDS=120
# Production API readiness requires the backup service's atomically replaced
# marker. Compose supplies this internal read-only path automatically; set it
# explicitly only for a standalone production topology.
BACKUP_SUCCESS_MARKER_FILE=
# Production API aggregate readiness probes this filesystem. Compose pins it to
# /app/runtime on runtime_data; standalone production must set an absolute path
# on the persistent filesystem used for runtime state.
DISK_READINESS_PATH=
# Shared 1 GiB free-space floor: PostgreSQL container health applies it to
# db_data, and API aggregate readiness applies it to DISK_READINESS_PATH.
HEALTH_DISK_MIN_FREE_KB=1048576

# --- Encrypted off-host PostgreSQL backups (optional `backup` Compose profile) ---
# Restic encrypts data client-side before uploading. Use a repository on storage
# that is not on the application VPS (for example an S3-compatible bucket).
BACKUP_REPOSITORY=
BACKUP_ENCRYPTION_PASSWORD=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=
# One-hour RPO. The backup container and aggregate API readiness are unhealthy
# after 90 minutes without a successful off-host snapshot.
BACKUP_INTERVAL_SECONDS=3600
BACKUP_MAX_STALE_SECONDS=5400
# Used only by the isolated restore-check database.
RESTORE_CHECK_PASSWORD=
