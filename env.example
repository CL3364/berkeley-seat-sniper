# Berkeley Seat Sniper — environment template.
# Copy to `.env` (gitignored) and fill in. NEVER commit real secrets; the app
# reads these from the environment only (constitution). Values here are safe
# non-secret placeholders / documentation.

# --- Server ---
PORT=8787
NODE_ENV=development

# --- Database (production: real Postgres; dev/test default: in-process PGlite) ---
# When unset, the app/tests use an ephemeral in-process Postgres (PGlite).
DATABASE_URL=

# --- Token signing (FR-2: signed, expiring, per-subscriber manage links) ---
# Required in production. A long random string; rotate to invalidate all tokens.
TOKEN_SECRET=
TOKEN_TTL_SECONDS=2592000

# --- Poller / scraper (FR-3, FR-7) ---
# Cadence ~30s: the one-fetch-per-unique-Section fan-out makes per-Section load trivial at
# pilot scale, and faster detection is the product's whole value (grill Q2).
POLL_INTERVAL_SECONDS=30
POLL_JITTER_SECONDS=10
FETCH_USER_AGENT=BerkeleySeatSniper/0.2 (+mailto:ops@example.edu)
KILL_SWITCH=0
RESPECT_ROBOTS=1

# --- Mail (FR-8: noop writes to an outbox log; real transports configured here) ---
MAIL_TRANSPORT=noop
MAIL_FROM=alerts@example.edu
# Operator inbox for parser-broke / scraper-failure alerts (NOT a subscriber address).
# REQUIRED for any launch and must be MONITORED: if unset it falls back to MAIL_FROM, so a
# scraper break could go unnoticed and the pilot would silently stop alerting. See ADR 0009
# / docs/plans/0009.
OPERATOR_EMAIL=
# Real transport secrets (only when MAIL_TRANSPORT != noop) come from the env, e.g.:
# RESEND_API_KEY=
# SMTP_URL=

# --- Rate limiting (anti-abuse on POST /api/subscriptions; implements the 429 code) ---
RATE_LIMIT_SUBSCRIBE_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60
# Set TRUST_PROXY=1 ONLY when behind a trusted proxy (e.g. Caddy) that sets X-Forwarded-For;
# otherwise the client could spoof its IP to evade the limit.
TRUST_PROXY=0

# --- Optional web push (VAPID keys are secrets; env only) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.edu
