# Exclude build artifacts (builder stage generates fresh output).
node_modules
dist

# VCS and editor metadata.
.git
.github
.gitignore
.gitattributes
.prettierignore
.prettierrc.json
.duet
.mcp.json
.playwright-mcp

# Secrets and env files — NEVER baked into the image.
.env
.env.*
.npmrc
*.key
*.pem
*.p12
*.pfx
*vapid*
secrets
secrets/**
.secrets
.secrets/**

# Subscriber stores, local databases, outboxes, and backup artifacts are
# sensitive even when their filenames are not.
data
data/**
backups
backups/**
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.db-*
*.dump
*.backup
*.ndjson
.restic

# Test/QA directories not needed in production images.
tests
e2e
coverage
# INVARIANT: anything `tsconfig.json` includes must either be present in the build
# context or excluded ALONGSIDE whatever it imports. The image builds with
# `COPY . .` then `npm run build` (= `tsc --noEmit && vite build`), so a config
# file that survives here while its sources do not fails the build with TS2307 —
# and it CANNOT reproduce locally, where those directories exist.
# `playwright.config.ts` imports `./e2e/outbox`, so it must go wherever `e2e` goes.
playwright.config.ts

# Documentation files.
*.md
CONTEXT.md
constitution.md

# Playwright artifacts.
playwright-report
test-results
*.png

# Editor and OS metadata.
.DS_Store
*.swp
